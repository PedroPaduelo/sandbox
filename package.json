{
  "name": "sandbox-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox runtime: expõe filesystem + shell + process tools via MCP Streamable HTTP.",
  "scripts": {
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.cjs",
    "dev": "tsx watch --env-file-if-exists=.env.dev src/server.ts",
    "dev:prod": "tsx watch --env-file-if-exists=.env.prod src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/fastify-api-reference": "^1.55.1",
    "@sinclair/typebox": "^0.34.49",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.5",
    "mime-types": "^3.0.2",
    "typescript-language-server": "^5.2.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-ws-jsonrpc": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
